# 构建产物：仅仓库根目录下的 dist/（make linux 的交叉编译输出）。
# ⚠ 必须写成 /dist/ 用前导斜杠锚定根目录。
#   若写成 dist/，会连 internal/web/dist/ 一起忽略 ——
#   那是被 go:embed 嵌入的前端源码（app.js / index.html / style.css / status.js），
#   漏跟踪会导致克隆仓库后无法编译：
#     pattern dist: no matching files found
/dist/

# 二进制（构建产物一律不入库，分发走 Release；agent.exe 曾误提交，已移除跟踪）
/rollcall-server
/rollcall-agent
/rollsign
/probe-server
/probe-agent
*.exe

# 运行时数据（含管理令牌与节点上报令牌，不可入库）
/data/
/cmd/server/data/
/cmd/agent/data/

# 编辑器备份与日志
*~
*.log

# 本地 Agent 配置（agent 默认 -config ./agent.json，内含节点上报令牌）
# 不锚定根目录：运维常在任意工作目录下用相对路径启动 Agent，
# 只拦 /agent.json 等于只保护了文档里的那一种启动方式。
agent.json
# 但随仓库分发的示例配置必须保留：未锚定的规则会在文件被删除后
# 阻止重新 git add deploy/agent.json。
!/deploy/agent.json

# 工具链 / IDE / 系统产物
.DS_Store
Thumbs.db
.idea/
.vscode/
*.test
coverage.out

# 密钥与证书材料
# rollsign 默认把 Agent 自更新签名私钥写到仓库根（rollsign.key）。
# 私钥一旦入库，等于把更新信任链的根交出去 —— 攻击者可签任意 Agent 二进制。
*.key
*.pem
*.p12
*.pfx
*.p8
# 签名校验测试需要一次性密钥对作夹具，不属于运行时凭据
# 含斜杠的模式相对 .gitignore 所在目录，原来的 !testdata/** 只放行根目录下的
# 夹具；internal/*/testdata 里的夹具仍被 *.key 挡住。用 **/ 前缀匹配任意层级。
!**/testdata/**/*.key
!**/testdata/**/*.pem

# 其他凭据载体：环境变量文件、导出的管理令牌、面板账号文件
.env
.env.*
# 示例/模板文件不含真实凭据，按约定允许入库
!.env.example
!.env.sample
!.env.template
admin.token
# 面板管理员账号（仅 PBKDF2 哈希）；运行时位于数据目录，此处防止本地测试时落在仓库里
admin-user.json
