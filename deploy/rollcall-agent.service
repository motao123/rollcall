[Unit]
Description=Rollcall Agent (read-only metrics reporter)
Documentation=https://github.com/motao123/rollcall
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 专用低权限用户：Agent 只需读取 /proc，无需 root。
# 创建：useradd --system --no-create-home --shell /usr/sbin/nologin rollcall-agent
# 配置：/etc/rollcall 属组 rollcall-agent(0750)，agent.json 属主 root:rollcall-agent(0640)
User=rollcall-agent
Group=rollcall-agent
ExecStart=/usr/local/bin/rollcall-agent -config /etc/rollcall/agent.json
Restart=always
RestartSec=10s

# ---- 可选：签名自更新 ----
# 自更新需要 Agent 对二进制所在目录有写权限。默认 /usr/local/bin 归 root，
# 请改用专用目录并在 drop-in 中重写 ExecStart、放行写路径，例如：
#   install -d -o rollcall-agent -g rollcall-agent -m 0750 /opt/rollcall-agent
#   [Service]
#   ExecStart=
#   ExecStart=/opt/rollcall-agent/rollcall-agent -config /etc/rollcall/agent.json
#   ReadWritePaths=/opt/rollcall-agent
# 详见 docs/operations.md「Agent 签名自更新」。

# ---- 最小权限加固：Agent 只需要读 /proc ----
# 这一段必须与 /agent/install.sh 生成的单元逐项一致（internal/web/agent_install.go）：
# 两种接入方式的安全姿态一旦分叉，用户以为自己在跑最小权限，实际未必。
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
# /proc 读取是唯一需要的权限
ReadOnlyPaths=/proc

[Install]
WantedBy=multi-user.target
