# Rollcall 服务端环境变量模板（systemd EnvironmentFile / OpenRC 共用）
#
# 安装位置：/etc/rollcall/server.env，权限必须 0600
#   install -m 0600 rollcall.env.example /etc/rollcall/server.env
# systemd 单元里以 `EnvironmentFile=-/etc/rollcall/server.env` 引入（前导 "-" 表示
# 文件缺失也能启动，账号建好后即可删除本文件）。
#
# ★ 除 ROLLCALL_ADMIN_PASSWORD / ROLLCALL_ADMIN_EMAIL 外，其余配置项都不是环境
#   变量，而是命令行参数：用 drop-in 覆盖 ExecStart（见 deploy/rollcall-server.service
#   顶部注释）。把它们塞进环境变量不会生效——Go 的 flag 包只读命令行。
#
# ★ 本文件里只有两项：

# 首次启动时创建管理员账号用的初始密码（≥12 位）。
# 账号创建后本项即被忽略，可以删除。
# 留空则由服务端生成随机密码并打印到日志（仅一次）：
#   journalctl -u rollcall-server | grep -A2 初始密码
ROLLCALL_ADMIN_PASSWORD=

# 管理员邮箱（可登录、可用于找回；留空则只能用用户名登录）
ROLLCALL_ADMIN_EMAIL=

# ============================================================================
# 常用启动参数速查（写在 ExecStart 里，不是这里）
# ============================================================================
#
#   -addr 127.0.0.1:19080          监听地址。默认回环；对外请经反代。
#                                  改绑 0.0.0.0 必须启用内置 TLS，否则拒绝启动。
#   -data /opt/rollcall/data       数据目录（快照、历史、备份、主题包）
#   -timezone Asia/Shanghai        显示与统计时区（IANA 名；也可用 TZ 环境变量）
#   -panel-link https://m.example.com
#                                  对外地址，决定告警链接与接入命令里的主机名；
#                                  面板里也能改（设置 → 对外地址），此参数优先
#   -trusted-proxies 127.0.0.1/32  允许提交 X-Forwarded-For 的反代地址。
#                                  ★ 反代部署必须配，否则 Cookie 无 Secure、
#                                    审计里记录的来源 IP 全是反代地址。
#   -tls-cert / -tls-key           内置 TLS。仅在无法用反代时使用。
#   -allow-insecure                允许明文监听非回环地址（容器内必需）
#   -allow-private-probes          允许探测私网目标（默认拒绝，防 SSRF）
#   -allow-private-notify          允许向私网推送通知
#   -insecure-probe-tls            探测 HTTPS 目标时跳过证书校验（不建议）
#   -backup-password-file <path>   自动加密备份的口令文件（0600），
#   -backup-interval 24h           配合使用
#   -backup-keep 14
#   -save-interval 60s             快照落盘间隔
#   -probe-interval 60s            服务探测默认间隔
#   -cny-rate 7.2                  非 CNY 成本折算汇率
#   -admin-token <48位>            管理令牌（脚本/自动化调用 API 用）
#   -reset-admin-password -admin-password '新密码'
#                                  重置管理员密码后退出
#   -demo                          演示模式（内置假数据，端口建议换一个）
